# GripetteOS copy of grabette:packages/gripette/systemd/gripette-web.service,
# adapted for the baked image: User=pollen, checkout at /home/pollen/grabette.
# Enabled by default (dashboard on port 8000), as make install-systemd does.
# Keep in sync with the source unit when it changes.
[Unit]
Description=Gripette - dashboard (web UI)
After=network.target

[Service]
Type=simple
User=pollen
WorkingDirectory=/home/pollen/grabette
ExecStart=/home/pollen/grabette/.venv/bin/python -m gripette.webui
Restart=on-failure
RestartSec=5
# Lower CPU priority than gripette.service: on the Pi Zero 2W the gripper's
# command and camera stream must win over page rendering.
Nice=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Same per-device config as the main service (GRIPPER_WEB_PORT, GRIPPER_PORT).
EnvironmentFile=-/etc/gripette/env

[Install]
WantedBy=multi-user.target
