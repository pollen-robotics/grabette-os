#!/bin/sh -e
# Derive GRIPPER_HAND from the hostname set in Raspberry Pi Imager
# (gripette-left / gripette-right). Runs as root from gripette.service's
# ExecStartPre on every start until it has succeeded once; append-only so
# calibration offsets in /etc/gripette/env are never touched.
grep -q '^GRIPPER_HAND=' /etc/gripette/env 2>/dev/null && exit 0
case "$(hostname)" in
  *left*)  HAND=left ;;
  *right*) HAND=right ;;
  *)
    echo "gripette: hostname '$(hostname)' matches neither left nor right;" \
         "set the hostname (Imager or 'sudo hostnamectl set-hostname gripette-left')" \
         "or add GRIPPER_HAND=left|right to /etc/gripette/env" >&2
    exit 1 ;;
esac
mkdir -p /etc/gripette
printf 'GRIPPER_HAND=%s\n' "$HAND" >> /etc/gripette/env
echo "gripette: GRIPPER_HAND=$HAND (from hostname $(hostname))"
