# GripetteOS copy of grabette:packages/gripette/systemd/gripette-bluetooth.service,
# adapted for the baked image: checkout at /home/pollen/grabette.
# Keep in sync with the source unit when it changes.
[Unit]
Description=Gripette Bluetooth WiFi Setup
After=bluetooth.target
Requires=bluetooth.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStart=/home/pollen/grabette/.venv/bin/python -m gripette.bluetooth
Restart=on-failure
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1
# Runs as root: don't let it write root-owned .pyc caches (now including
# cryptography's, pulled in for BLE WiFi sealing) into the pollen-owned .venv.
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
